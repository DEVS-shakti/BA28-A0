rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function admin() { return request.auth != null && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin'; }
    match /imports/{allPaths=**} { allow read, write: if admin(); }
    match /reports/{uid}/{allPaths=**} { allow read: if request.auth != null && request.auth.uid == uid || admin(); allow write: if admin(); }
  }
}
