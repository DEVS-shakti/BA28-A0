rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'; }
    match /users/{uid} { allow read: if signedIn() && (request.auth.uid == uid || admin()); allow write: if admin(); }
    match /classes/{classId} { allow read: if signedIn(); allow write: if admin(); }
    match /students/{studentId} { allow read: if signedIn() && (admin() || resource.data.userId == request.auth.uid); allow write: if admin(); }
    match /tests/{testId} { allow read: if signedIn(); allow write: if admin(); }
    match /results/{resultId} { allow read: if signedIn() && (admin() || resource.data.userId == request.auth.uid || resource.data.public == true); allow write: if admin(); }
    match /auditLogs/{logId} { allow read, write: if admin(); }
    match /imports/{importId} { allow read, write: if admin(); }
  }
}
